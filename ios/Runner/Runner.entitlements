<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs) simdilik kapali: App ID'de Push capability tanimli degil
	     (Account Holder eklemeli) ve Firebase'e APNs anahtari yuklenmedi.
	     Acilacagi zaman: aps-environment=production geri ekle + profili yenile. -->
	<!-- Sign in with Apple — App Store 4.8 zorunluluğu. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
